{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  additionalBranchPrefix: "{{manager}}/",
  labels: ["dependencies"],
  commitMessageAction: "Bump",
  extends: ["config:best-practices"],
  packageRules: [
    {
      description: "Update these NuGet packages manually with the upstream distribution (see docs/bump-upstream.md)",
      matchManagers: ["nuget"],
      matchPackageNames: [
        "Google.Protobuf",
        "Microsoft.Extensions.Configuration.EnvironmentVariables",
        "Microsoft.Extensions.Logging",
        "Microsoft.Extensions.Logging.Abstractions",
        "Microsoft.Extensions.Logging.Console",
        "OpenTelemetry.Api",
        "OpenTelemetry.AutoInstrumentation",
        "OpenTelemetry.AutoInstrumentation.PluginApi",
        "OpenTelemetry.Exporter.OpenTelemetryProtocol",
        "OpenTelemetry.Instrumentation.AspNet",
        "OpenTelemetry.Instrumentation.AspNetCore",
        "OpenTelemetry.OpAmp.Client",
        "System.Collections.Immutable",
        "System.Diagnostics.DiagnosticSource",
      ],
      enabled: false,
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update Debian arm64 package version ENVs in Dockerfiles",
      managerFilePatterns: ["/^docker\\/debian-arm64\\.dockerfile$/"],
      matchStrings: [
        "#\\s*renovate:\\s*(?:suite=(?<suite>\\S+)\\s+)?depName=(?<depName>\\S+)\\s*\\n\\s*ENV\\s+.*?_VERSION=\"(?<currentValue>[^\"]+)\"",
      ],
      registryUrlTemplate: "https://deb.debian.org/debian?suite={{#if suite}}{{suite}}{{else}}bookworm{{/if}}&components=main&binaryArch=arm64",
      datasourceTemplate: "deb",
    },
    {
      customType: "regex",
      description: "Update Alpine package version ENVs in Dockerfiles",
      managerFilePatterns: ["/^docker\\/alpine-(x64|arm64)\\.dockerfile$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ENV\\s+.*?_VERSION=\"(?<currentValue>[^\"]+)\"",
      ],
      packageNameTemplate: "alpine_3_24/{{{depName}}}",
      versioningTemplate: "apk",
    },
  ],
  prConcurrentLimit: 20,
}
